APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

SECRET_KEY=change-me-in-production-use-a-strong-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yandex_driver
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

YANDEX_FLEET_BASE_URL=https://fleet-api.taxi.yandex.net

YANDEX_MOCK_MODE=true
YANDEX_CLIENT_ID=
YANDEX_API_KEY=
YANDEX_PARK_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_BACKEND_URL=http://127.0.0.1:8000
TELEGRAM_BOT_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_BOT_DB_PATH=.data/telegram_bot.sqlite3
TELEGRAM_BOT_ORDERS_PAGE_SIZE=5

ORDER_SYNC_INTERVAL_SECONDS=10
DRIVER_SYNC_INTERVAL_SECONDS=300
VEHICLE_SYNC_INTERVAL_SECONDS=600

LOG_LEVEL=INFO
