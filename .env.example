APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

SECRET_KEY=change-me-in-production-use-a-strong-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/yandex_driver
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0

YANDEX_FLEET_BASE_URL=https://fleet-api.taxi.yandex.net

YANDEX_CLIENT_ID=your_client_id_here
YANDEX_API_KEY=your_api_key_here
YANDEX_PARK_ID=your_park_id_here

ORDER_SYNC_INTERVAL_SECONDS=10
DRIVER_SYNC_INTERVAL_SECONDS=300
VEHICLE_SYNC_INTERVAL_SECONDS=600

LOG_LEVEL=INFO
