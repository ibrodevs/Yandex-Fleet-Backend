APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stage 1 does not need PostgreSQL/Redis yet.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yandex_driver
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6379/0

YANDEX_FLEET_BASE_URL=https://fleet-api.taxi.yandex.net
YANDEX_MOCK_MODE=true
YANDEX_CLIENT_ID=
YANDEX_API_KEY=
YANDEX_PARK_ID=

TELEGRAM_BOT_TOKEN=PUT_BOTFATHER_TOKEN_HERE

# PythonAnywhere production mode: Telegram calls FastAPI webhook.
TELEGRAM_BOT_MODE=webhook

# For free PythonAnywhere accounts aiogram/aiohttp should use
# PythonAnywhere's outbound proxy. Paid accounts can leave this empty.
TELEGRAM_HTTP_PROXY=http://proxy.server:3128

# Replace YOURUSERNAME with the PythonAnywhere account name.
TELEGRAM_WEBHOOK_BASE_URL=https://YOURUSERNAME.pythonanywhere.com
TELEGRAM_WEBHOOK_PATH=/api/v1/telegram/webhook

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TO_RANDOM_WEBHOOK_SECRET
TELEGRAM_WEBHOOK_AUTO_SETUP=true
TELEGRAM_MINI_APP_URL=
TELEGRAM_MINI_APP_DEMO_MODE=true

# Use an absolute persistent path on PythonAnywhere.
TELEGRAM_BOT_DB_PATH=/home/YOURUSERNAME/Yandex-Fleet-Backend/.data/telegram_bot.sqlite3
TELEGRAM_BOT_ORDERS_PAGE_SIZE=5

ORDER_SYNC_INTERVAL_SECONDS=10
DRIVER_SYNC_INTERVAL_SECONDS=300
VEHICLE_SYNC_INTERVAL_SECONDS=600

LOG_LEVEL=INFO
